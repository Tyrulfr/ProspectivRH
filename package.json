{
  "name": "prospectivrh",
  "version": "0.1.0",
  "private": true,
  "description": "Application locale de prospective GPEC pour la recherche à l’Université Paris-Saclay",
  "author": "Université Paris-Saclay",
  "packageManager": "pnpm@11.19.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Tyrulfr/ProspectivRH.git"
  },
  "homepage": "https://tyrulfr.github.io/ProspectivRH/",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "desktop:renderer": "vite build --config desktop/vite.config.ts",
    "desktop:dev": "electron desktop/app/main.cjs --dev",
    "desktop:build": "pnpm run desktop:renderer && electron-builder --mac dir",
    "public:build": "vite build --config vite.public.config.ts",
    "check": "pnpm run lint && pnpm run test && pnpm run public:build",
    "test": "pnpm run build && node --experimental-strip-types --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "read-excel-file": "^9.3.10"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "main": "desktop/app/main.cjs",
  "build": {
    "appId": "fr.universite-paris-saclay.prospectivrh",
    "productName": "ProspectivRH",
    "directories": {
      "app": "desktop/app",
      "buildResources": "desktop",
      "output": "release"
    },
    "files": [
      "main.cjs",
      "renderer/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.business",
      "icon": "icon.png",
      "target": [
        "dir"
      ]
    }
  },
  "type": "module"
}
